# Dashboard login password (choose any strong password)
DASHBOARD_PASSWORD=
# Random secret for the 5-minute cron URL (cron-job.org calls /api/cron?key=THIS)
CRON_SECRET=
# Same value as the UPLOAD_TOKEN the daily reel task already uses (lets it add reels to the queue)
UPLOAD_TOKEN=
# Added automatically when you connect Upstash Redis and Vercel Blob in the Vercel Storage tab:
# KV_REST_API_URL / KV_REST_API_TOKEN (or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)
# BLOB_READ_WRITE_TOKEN
